{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "statmanposterbot",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // Watchdog for render jobs that never report back (see scheduled() in worker/index.ts).
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "GITHUB_REPO": "edwardjones7/statmanposterbot",
    // New posts from this X account are offered in Telegram (/watch on|off).
    "WATCH_HANDLE": "EdTheStatMan",
    "WORKER_URL": "https://statmanposterbot.tweet-to-instagram-pipeline.workers.dev",
    // Caption model (Workers AI free tier: 10k neurons/day, roughly 100 captions).
    "CAPTION_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  "d1_databases": [
    // Job state (strongly consistent). Schema in migrations/, applied with
    // `wrangler d1 migrations apply statmanposterbot --remote`.
    { "binding": "DB", "database_name": "statmanposterbot", "database_id": "7637f4c7-899d-4ba3-9bac-66bbaae91d79" }
  ],
  "kv_namespaces": [
    // Slide images. Created with `wrangler kv namespace create STORE`.
    { "binding": "STORE", "id": "0aeda956f31e49fa9ed9e9be17c8d54a" }
  ],
  "ai": { "binding": "AI" },
  // Secrets (set with `wrangler secret put <NAME>`, never committed):
  //   TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, TELEGRAM_ALLOWED_USER_IDS,
  //   GITHUB_TOKEN, JOB_CALLBACK_SECRET, IG_ACCESS_TOKEN
}
